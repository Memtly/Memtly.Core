@model Memtly.Core.Views.Account.Settings.Gallery.GalleryOverridesModel
@using Memtly.Core.Constants

@if (Model?.Settings != null && Model.Settings.Any())
{
    <div class="setting-section">
        <h5 class="mb-3">@_localizer["UserInteractions"].Value</h5>

        <div class="row mb-4 mb-lg-4 setting-container">
            <div class="col-12">
                <label class="setting-label">@_localizer["Settings_Gallery_Likes_Label"].Value</label>
                <select class="setting-field form-control" data-setting-name="@MemtlyConfiguration.Gallery.Likes">
                    @foreach (var option in ViewOptions.YesNo)
                    {
                        if (Model.Settings.GetValue(MemtlyConfiguration.Gallery.Likes.ToUpper(), "true").Equals(option.Value, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@option.Value" selected="selected">@option.Key</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Key</option>
                        }
                    }
                </select>
                <div class="setting-hint form-text">@_localizer["Settings_Gallery_Likes_Hint"].Value</div>
            </div>
        </div>

        <div class="row mb-4 mb-lg-4 setting-container">
            <div class="col-12">
                <label class="setting-label">@_localizer["Settings_Gallery_Comments_Label"].Value</label>
                <select class="setting-field form-control" data-setting-name="@MemtlyConfiguration.Gallery.Comments">
                    @foreach (var option in ViewOptions.YesNo)
                    {
                        if (Model.Settings.GetValue(MemtlyConfiguration.Gallery.Comments.ToUpper(), "true").Equals(option.Value, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@option.Value" selected="selected">@option.Key</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Key</option>
                        }
                    }
                </select>
                <div class="setting-hint form-text">@_localizer["Settings_Gallery_Comments_Hint"].Value</div>
            </div>
        </div>
    </div>
}