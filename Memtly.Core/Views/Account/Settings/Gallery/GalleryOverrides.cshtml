@model Memtly.Core.Views.Account.Settings.Gallery.GalleryOverridesModel

@if (Model?.Settings != null && Model.Settings.Any())
{
    <partial name="~/Views/Account/Settings/Gallery/GalleryOverrides/Layout.cshtml" model="Model" />
    <partial name="~/Views/Account/Settings/Gallery/GalleryOverrides/Uploads.cshtml" model="Model" />
    <partial name="~/Views/Account/Settings/Gallery/GalleryOverrides/Downloads.cshtml" model="Model.Settings" />
    <partial name="~/Views/Account/Settings/Gallery/GalleryOverrides/Reviews.cshtml" model="Model" />
    <partial name="~/Views/Account/Settings/Gallery/GalleryOverrides/ViewOptions.cshtml" model="Model.Settings" />
    @if (Model.Type != GalleryType.Collection && _identity.IsPrivilegedUser(User))
    {
        <partial name="~/Views/Account/Settings/Gallery/GalleryOverrides/SizeLimits.cshtml" model="Model.Settings" />
    }
    <partial name="~/Views/Account/Settings/Gallery/GalleryOverrides/QrCodes.cshtml" model="Model.Settings" />
}