@model GalleriesModel
@using Memtly.Core.Constants
@using Memtly.Core.Views.Account.Tabs

@{
    var userPermissions = User?.Identity?.GetUserPermissions() ?? new Permissions();
    
    var searchTerm = string.Empty;
    try
    {
        searchTerm = (Context.Request.Query.ContainsKey("term") ? Context.Request.Query["term"].ToString() : string.Empty);
    }
    catch { }
}

<section class="pnl-account pnl-account-galleries pb-0 pb-lg-4">
    <div class="container px-3 px-lg-1 my-3 my-lg-0">
        <div class="row">
            <div class="col-12">
                <h1 class="display-6">@_localizer["Galleries"].Value
                    <span class="header-actions">
                        @if (!await _settings.GetOrDefault(MemtlyConfiguration.Basic.SingleGalleryMode, false))
                        {
                            if (userPermissions.Gallery.HasFlag(GalleryPermissions.Create))
                            {
                                <span class="btnAddGallery action link-primary-2 pointer" alt="@_localizer["Create"].Value" title="@_localizer["Create"].Value">
                                    <i class="fas fa-calendar-plus"></i>
                                    <span>@_localizer["Gallery"].Value</span>
                                </span>
                            }
                            else if (userPermissions.Features.HasFlag(FeaturePermissions.UpgradeToUnlock))
                            {
                                <span class="action text-muted pointer" alt="@_localizer["Create"].Value (@_localizer["Upgrade_To_Unlock"].Value)" title="@_localizer["Create"].Value (@_localizer["Upgrade_To_Unlock"].Value)">
                                    <i class="fas fa-calendar-plus upgradeToUnlock" disabled="disabled" alt="@_localizer["Create"].Value"></i>
                                    <span>@_localizer["Gallery"].Value</span>
                                </span>
                            }

                            if (userPermissions.Collection.HasFlag(CollectionPermissions.Create))
                            {
                                <span class="btnAddCollection action link-primary-2 pointer" alt="@_localizer["Create"].Value" title="@_localizer["Create"].Value">
                                    <i class="fas fa-folder-plus"></i>
                                    <span>@_localizer["Collection"].Value</span>
                                </span>
                            }
                            else if (userPermissions.Features.HasFlag(FeaturePermissions.UpgradeToUnlock))
                            {
                                <span class="action text-muted pointer" alt="@_localizer["Create"].Value (@_localizer["Upgrade_To_Unlock"].Value)" title="@_localizer["Create"].Value (@_localizer["Upgrade_To_Unlock"].Value)">
                                    <i class="fas fa-folder-plus upgradeToUnlock" disabled="disabled" alt="@_localizer["Create"].Value"></i>
                                    <span>@_localizer["Collection"].Value</span>
                                </span>
                            }
                        }
                    </span>
                </h1>
            </div>
        </div>
        <div class="row mt-3 mb-4">
            <div class="col-12 col-md-7 col-lg-9 mb-lg-0">
                <label>@_localizer["SearchTerm_Label"].Value</label>
                <input id="galleries-search-term" class="form-control" type="text" placeholder="" value="@searchTerm" />
                <div class="form-text">@_localizer["SearchTerm_Help"].Value</div>
            </div>
            <div class="col-12 col-md-5 col-lg-3 mb-3 mb-lg-0">
                <label>@_localizer["Type"].Value</label>
                <select id="galleries-type" class="form-control">
                    @foreach (GalleryType type in Enum.GetValues(typeof(GalleryType)))
                    {
                        if (type == GalleryType.All)
                        {
                            <option value="@((int)type)" selected="selected">@type.ToString()</option>
                        }
                        else
                        {
                            <option value="@((int)type)">@type.ToString()</option>
                        }
                    }
                </select>
                <div class="form-text">@_localizer["Gallery_Type_Help"].Value</div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <h3 class="display-7">@_localizer["Owned_By_You"].Value</h3>
            </div>
        </div>
        <div class="row mb-4">
            <div id="galleries-list" class="col-12">
                <partial name="~/Views/Account/Partials/GalleriesList.cshtml" model="Model" />
            </div>
        </div>
        @if (Model.SharedGalleries != null && Model.SharedGalleries.Any())
        {
            <div class="row">
                <div class="col-12">
                    <h3 class="display-7">@_localizer["Shared_With_You"].Value</h3>
                </div>
            </div>
            <div class="row mb-4">
                <div id="shared-galleries-list" class="col-12">
                    <partial name="~/Views/Account/Partials/SharedGalleriesList.cshtml" model="Model" />
                </div>
            </div>
        }
        @if (Model.RecentGalleries != null && Model.RecentGalleries.Any())
        {
            <div class="row">
                <div class="col-12">
                    <h1 class="display-7">@_localizer["Recently_Visited"].Value</h1>
                </div>
            </div>
            <div class="row mb-4">
                <div id="recent-galleries-list" class="col-12">
                    <partial name="~/Views/Account/Partials/RecentGalleriesList.cshtml" model="Model" />
                </div>
            </div>
        }
    </div>
</section>